# ==============================================================================
# BYTEVIPERS CODING ARENA - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment: 'production', 'development', or 'testing'
ENVIRONMENT=production

# Application Security (Generate a secure random key: openssl rand -hex 32)
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Database: Neon PostgreSQL (or other managed PostgreSQL instance)
# Format: postgresql+asyncpg://<username>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>/<database>?sslmode=require

# Local Container Database (Optional if running local db in docker)
POSTGRES_USER=bytevipers
POSTGRES_PASSWORD=replace-with-secure-database-password
POSTGRES_DB=bytevipers

# Code Execution Engine (Judge0 CE / RapidAPI)
# In production, sandboxed Judge0 is strictly enforced; local subprocess fallback is disabled.
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_USE_RAPIDAPI=false
JUDGE0_SUBMISSION_TIMEOUT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=128000
JUDGE0_CPU_TIME_LIMIT_SECONDS=2.0
JUDGE0_FALLBACK_ISOLATED=false
ALLOW_SUBPROCESS_FALLBACK_IN_PRODUCTION=false

# CORS Allowed Origins (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://arena.bytevipers.com"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
